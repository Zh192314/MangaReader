* text=auto

# Shell / CI 脚本必须 LF，否则 macOS runner 上会报 "bad interpreter: ^M"
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.swift text eol=lf
*.plist text eol=lf
*.json text eol=lf
*.md   text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.ipa  binary
*.p12  binary
*.mobileprovision binary
